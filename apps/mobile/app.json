{
  "expo": {
    "name": "Dirary",
    "slug": "dirary",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dirary",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0B0E",
    "android": {
      "package": "com.lterckski.dirary",
      "adaptiveIcon": {
        "backgroundColor": "#7C83FF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notifications/icon.png",
          "color": "#7C83FF",
          "sounds": [
            "./assets/sounds/bark.wav"
          ],
          "defaultChannel": "ink-bark-2"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0B0E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Dirary uses the camera to scan food barcodes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Day",
              "label": "Your day",
              "description": "Tasks, money, food and your workout at a glance, with quick adds.",
              "minWidth": "250dp",
              "minHeight": "250dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widgets/day-preview.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "TodayTasks",
              "label": "Today's tasks",
              "description": "Tick off today's tasks and add new ones.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widgets/today-tasks-preview.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "InkProgress",
              "label": "Ink's progress",
              "description": "Ink cheers as you finish today's tasks.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "previewImage": "./assets/widgets/ink-progress-preview.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "TodaySpend",
              "label": "Spent today",
              "description": "Today's spending and what's left of this month's budgets.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "previewImage": "./assets/widgets/today-spend-preview.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "FoodToday",
              "label": "Food today",
              "description": "Calories and protein left today, and a quick way to log food.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "previewImage": "./assets/widgets/food-today-preview.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "WorkoutToday",
              "label": "Workout today",
              "description": "Today's workout, or a rest day, and your steps.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "previewImage": "./assets/widgets/workout-today-preview.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "cde9a8f7-f14e-420f-9336-355cab04c6fa"
      }
    }
  }
}
