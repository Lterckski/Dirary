{
  "expo": {
    "name": "Dirary",
    "slug": "dirary",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dirary",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0B0E",
    "android": {
      "package": "com.lterckski.dirary",
      "adaptiveIcon": {
        "backgroundColor": "#7C83FF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0B0E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite",
      "expo-font",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "InkTest",
              "label": "Ink (test)",
              "description": "Phase 0 test widget: Ink says hello.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "previewImage": "./assets/widgets/ink-test-preview.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}